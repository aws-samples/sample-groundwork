# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore real env files, but keep the secret-free template.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite database (local dev)
*.db
*.db-wal
*.db-shm

# Stray local artifacts (screenshots, exported PDFs, etc.) — not source
*.pdf

# python (connectors/, tools/coa-pack/ — run via uv)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ASH (Automated Security Helper) scan output — generated; keep config (.ash/.ash.yaml), not results
.ash/ash_output/
ash_output/
# Internal demo scripts / sales enablement — local-only, not published
demo/

# transient security-scan staging
.sgscan/
.sgscan-out/

# local license-review artifacts for SG ticket (not shipped)
license-review/
